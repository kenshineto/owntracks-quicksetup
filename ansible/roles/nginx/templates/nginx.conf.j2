user owntracks;
worker_processes auto;

events {
	worker_connections 1024;
	multi_accept on;
}

http {
	include mime.types;
	default_type application/octet-stream;

	sendfile on;
	tcp_nopush on;
	tcp_nodelay on;
	keepalive_timeout 65;
	types_hash_max_size 2048;
	server_tokens off;

	server_names_hash_bucket_size 64;
	map_hash_bucket_size 64;

	access_log /dev/stdout;
	error_log /dev/stderr;

	gzip on;
	gzip_vary on;
	gzip_proxied any;
	gzip_comp_level 5;

	map $cookie_otrauth $owntracks_hascookie {
		"{{ cookie_value }}" "off";
		default "{{ owntracks_name }}";
	}

	include conf.d/*.conf;
}
